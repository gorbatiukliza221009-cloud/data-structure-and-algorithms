#include <iostream>
using namespace std;

struct Lesson
{
    int start;
    int finish;
};

int main()
{
    int n;

    cout << "Enter number of lessons: ";
    cin >> n;

    Lesson a[100];

    for(int i = 0; i < n; i++)
    {
        cout << "Lesson " << i + 1 << endl;

        cout << "Start: ";
        cin >> a[i].start;

        cout << "Finish: ";
        cin >> a[i].finish;
    }

    for(int i = 0; i < n - 1; i++)
    {
        for(int j = 0; j < n - i - 1; j++)
        {
            if(a[j].finish > a[j + 1].finish)
            {
                swap(a[j], a[j + 1]);
            }
        }
    }

    cout << endl;
    cout << "Selected lessons:" << endl;

    int count = 0;
    int lastFinish = 0;

    for(int i = 0; i < n; i++)
    {
        if(a[i].start >= lastFinish)
        {
            cout << "Start: " << a[i].start
                 << " Finish: " << a[i].finish << endl;

            lastFinish = a[i].finish;
            count++;
        }
    }

    cout << endl;
    cout << "Maximum number of lessons: " << count << endl;

    return 0;
}
