#include <iostream>
#include <list>
#include <algorithm>
#include <cstdlib>
#include <ctime>
using namespace std;

void showList(list<int> numbers)
{
    for(list<int>::iterator it = numbers.begin(); it != numbers.end(); it++)
    {
        cout << *it << " ";
    }

    cout << endl;
}

int countUnique(list<int> numbers)
{
    numbers.sort();
    numbers.unique();

    return numbers.size();
}

int main()
{
    srand(time(0));

    list<int> list1;
    list<int> list2;

    int number;

    cout << "Enter 10 numbers:" << endl;

    for(int i = 0; i < 10; i++)
    {
        cin >> number;
        list1.push_back(number);
    }

    cout << "First list:" << endl;
    showList(list1);

    for(int i = 0; i < 10; i++)
    {
        number = rand() % 100 + 1;
        list2.push_back(number);
    }

    list2.sort();

    cout << "Second list:" << endl;
    showList(list2);

    list1.sort(greater<int>());
    list2.sort(greater<int>());

    list1.merge(list2, greater<int>());

    cout << "Merged list in descending order:" << endl;
    showList(list1);

    cout << "Amount of unique elements: " << countUnique(list1) << endl;

    return 0;
}
